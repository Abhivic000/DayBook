# Copy to .env (never committed) to override compose.yaml's development defaults.
# Every value here is optional.

# Main database user's password (Postgres and the API).
DAYBOOK_DB_PASSWORD=daybook

# Password for the consumer's least-privileged database role, created by migration V6.
# Only takes effect on a fresh database (docker compose down -v), when V6 runs.
DAYBOOK_CONSUMER_DB_PASSWORD=daybook_consumer

# SHA-256 (hex) of the admin key. Generate one in PowerShell:
#   $k = "my-admin-key"; -join ([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($k)) | % { $_.ToString("x2") })
DAYBOOK_ADMIN_KEY_SHA256=df76ff796f70d2c9cb055ea6280553caa27eda26b70e01082c160de75a05a4a9

# Database connections per API instance (instances x this must stay below Postgres's 100).
DAYBOOK_DB_POOL_SIZE=10

GRAFANA_ADMIN_PASSWORD=admin
