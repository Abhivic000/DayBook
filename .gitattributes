# Normalise line endings: LF in the repository and on checkout,
# so shell scripts run inside Docker and CI (Linux) without breaking.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch.
*.jar binary
*.png binary
*.jpg binary
