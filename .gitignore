# Project docs are kept local only (owner's choice), not versioned.
docs/
CLAUDE.md

# Build output
target/
!.mvn/wrapper/maven-wrapper.jar

# IDE
.github/modernize/
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
# VS Code's Java extension (Eclipse-based) compiles into bin/ per module.
bin/

# Secrets — never commit. Commit .env.example with placeholder values instead.
.env
.env.*
!.env.example

# k6 run output (the README records the measured numbers)
load/results/*
!load/results/.gitkeep

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
